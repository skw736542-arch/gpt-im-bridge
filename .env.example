# Run npm run setup to generate independent random secrets. Never commit .env.
HOST=127.0.0.1
PORT=8787
PUBLIC_ORIGIN=http://127.0.0.1:8787
ADMIN_PASSWORD=
ENCRYPTION_KEY=
DATA_DIR=./data
COOKIE_SECURE=false
# Use an existing HTTP(S)_PROXY when configured; localhost callbacks must bypass proxy.
NODE_USE_ENV_PROXY=1
NO_PROXY=localhost,127.0.0.1,::1
