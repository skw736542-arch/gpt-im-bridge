{
  "name": "gpt-im-bridge",
  "version": "0.9.0-alpha.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "tsx watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc && node scripts/build.mjs",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "test": "tsx --test test/*.test.ts",
    "test:ui": "node scripts/ui-test.mjs",
    "test:release": "node scripts/release-smoke.mjs",
    "test:docker": "node scripts/docker-smoke.mjs",
    "licenses": "node scripts/dependency-licenses.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@fastify/cookie": "11.1.3",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.7",
    "@tencent-connect/qqbot-nodejs": "1.0.5",
    "fastify": "5.12.7",
    "qrcode": "1.5.4",
    "silk-wasm": "3.7.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@types/node": "26.6.5",
    "@types/qrcode": "1.5.6",
    "playwright": "1.64.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "description": "Local-first ChatGPT subscription bridge for WeChat and QQ, with explicit memory, native QQ voice and bounded multimodal processing.",
